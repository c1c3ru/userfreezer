# Opt-in apenas em VM: o pacote NAO habilita esta unidade.
# %f decodifica a instancia de systemd-escape --path em path absoluto.
[Unit]
Description=DeepFreezer OverlayFS experimental, diretorio %f
After=local-fs.target
Before=multi-user.target deepfreezer.service
RequiresMountsFor=%f
ConditionPathIsDirectory=%f

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
# Sem ExecStop: systemctl stop nao desmonta; reiniciar VM de manutencao.
ExecStart=/usr/bin/python3 -B /opt/deepfreezer/overlayfs_session.py --target %f --enable --size-mb 128 --i-accept-volatile-protection --require-root-owned-ancestors --guard-config /etc/deepfreezer/config.json
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
