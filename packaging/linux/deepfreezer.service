[Unit]
Description=DeepFreezer - protecao de estado da arvore de diretorios (application-level)
After=local-fs.target
Requires=local-fs.target

[Service]
Type=simple
# Processo residente atende IPC local autenticado via SO_PEERCRED.
# Os comandos mutaveis exigem UID 0; consultas nao expoem segredos.
RuntimeDirectory=deepfreezer
RuntimeDirectoryMode=0755
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/deepfreezer/deepfreezerd.py --serve --config /etc/deepfreezer/config.json
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
